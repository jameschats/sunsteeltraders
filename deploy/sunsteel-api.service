[Unit]
Description=Sun Steel Traders .NET API
After=network.target mysql.service

[Service]
WorkingDirectory=/var/www/sunsteel/api
ExecStart=/usr/bin/dotnet /var/www/sunsteel/api/sunsteel.api.dll
EnvironmentFile=/etc/sunsteel/api.env
Restart=always
RestartSec=10
User=www-data

[Install]
WantedBy=multi-user.target
